{
    "name": "guardz-assignment",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "build": "nest build",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "test": "jest --testPathIgnorePatterns='.e2e.spec.ts$'",
        "test:watch": "jest --watch --testPathIgnorePatterns='.e2e.spec.ts$'",
        "test:cov": "jest --coverage --testPathIgnorePatterns='.e2e.spec.ts$'",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --testPathIgnorePatterns='!.e2e.spec.ts$' --testRegex='.e2e.spec.ts$'",
        "test:all": "jest"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/NoamYes/content-fetcher.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/NoamYes/content-fetcher/issues"
    },
    "homepage": "https://github.com/NoamYes/content-fetcher#readme",
    "dependencies": {
        "@nestjs/cli": "^11.0.10",
        "@nestjs/common": "^11.1.6",
        "@nestjs/config": "^4.0.2",
        "@nestjs/core": "^11.1.6",
        "@nestjs/platform-express": "^11.1.6",
        "@nestjs/swagger": "^8.1.1",
        "axios": "^1.12.2",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.2",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "swagger-ui-express": "^5.0.1",
        "typescript": "^5.9.2"
    },
    "devDependencies": {
        "@nestjs/testing": "^11.1.6",
        "@types/jest": "^29.5.14",
        "@types/node": "^24.5.2",
        "@types/supertest": "^6.0.2",
        "jest": "^29.7.0",
        "nodemon": "^3.1.10",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.5",
        "ts-node": "^10.9.2"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}
